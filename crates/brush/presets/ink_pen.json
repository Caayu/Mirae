{
  "format_version": 1,
  "id": "tela.ink-pen",
  "name": "Ink Pen",
  "metadata": {
    "author": "Tela",
    "description": "Crisp line art: pressure drives size, tapered ends, light stabilization.",
    "tags": ["ink", "lineart"]
  },
  "tip": { "shape": { "kind": "round" } },
  "properties": {
    "size": {
      "base": 8.0,
      "effectors": [{ "source": { "kind": "pressure" }, "curve": [[0.0, 0.05], [0.6, 0.75], [1.0, 1.0]] }]
    },
    "hardness": { "base": 0.95 },
    "spacing": { "base": 0.06 }
  },
  "taper": { "start": 15.0, "end": 25.0, "tip_scale": 0.05 },
  "stroke": { "stabilization": 30.0 }
}
